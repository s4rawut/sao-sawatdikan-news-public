# ค่าตั้งของเซิร์ฟเวอร์ (คัดลอกเป็น .env แล้วแก้) — ห้ามเผยแพร่ไฟล์ .env (อยู่ใน .gitignore แล้ว)
# คู่มือ: docs/self-hosting.md

# ---------- ที่อยู่เว็บ (ต้องตั้งก่อน build และตอนรัน) ----------
# ที่อยู่จริงที่ผู้ใช้เปิด (https) — ใช้ตรวจโดเมน การเข้าสู่ระบบ passkey และลิงก์ในอีเมล
SITE_URL=https://welfare.example.go.th
EMDASH_SITE_URL=https://welfare.example.go.th
# ชื่อโฮสต์อื่นที่อนุญาต (คั่นด้วยจุลภาค) เช่น IP ภายใน — ไม่มีก็เว้นว่าง
ALLOWED_HOSTS=

# ---------- เซิร์ฟเวอร์ ----------
HOST=127.0.0.1
PORT=4321
# header ที่ reverse proxy ใส่ IP ผู้ใช้จริง (nginx: X-Real-IP)
TRUSTED_PROXY_HEADERS=x-real-ip

# ---------- ข้อมูล (ต้องอยู่บนดิสก์ถาวร และสำรองทุกวัน) ----------
DATABASE_PATH=./data/emdash.db
UPLOADS_DIR=./data/uploads
SESSIONS_DIR=./data/sessions
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ---------- ความปลอดภัย ----------
# สร้างด้วย: npx emdash secrets generate   (สำรองค่าไว้ที่ปลอดภัย ถ้าหายจะถอดรหัสค่าลับของปลั๊กอินไม่ได้)
EMDASH_ENCRYPTION_KEY=
# รหัสเข้าเว็บช่วงทดสอบ (ทั้งเว็บต้องใส่รหัสก่อนเข้า) — เว้นว่างทั้งสองค่า = ไม่มีรหัส (เปิดใช้จริง)
SITE_GATE_USER=
SITE_GATE_PASS=

# ---------- ร้านค้า ----------
# live = แสดงบัญชีรับเงินจริงของร้าน · demo = แสดง QR ตัวอย่าง (ทดสอบ)
SHOP_PAYMENT_MODE=live
# อีเมลแอดมินร้าน (ใช้เมื่อยังไม่ได้ตั้งอีเมลรับแจ้งเตือนในหน้าตั้งค่าร้าน) คั่นด้วยจุลภาค
ADMIN_EMAILS=

# ---------- การแจ้งเตือน (ไม่บังคับ) ----------
# ส่งอีเมลผ่าน Google Apps Script (scripts/mail-webhook.gs) หรือ Resend
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# แจ้งคำสั่งซื้อใหม่เข้า Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# กันบอทหน้าเข้าสู่ระบบ/สมัครสมาชิก (Turnstile, ไม่บังคับ) — ต้องออกอินเทอร์เน็ตได้
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
