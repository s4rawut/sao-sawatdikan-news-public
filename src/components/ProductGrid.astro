---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { baht } from "../utils/shop";
import { bangkokToday, bulkLabel, bundleLabel, isNewProduct, promoActive } from "../shop/pricing.js";

type GridItem = ContentEntry<{
	title: string;
	image?: InferCollectionData<"products">["image"];
	price?: number;
	unit?: string;
	stock?: number;
	new_until?: string | null;
	bulk_qty?: number | null;
	bulk_price?: number | null;
	price_tiers?: string | null;
	price_bundles?: string | null;
	promo_badge?: boolean | number | null;
	new_badge?: boolean | number | null;
	promo_start?: string | null;
	promo_end?: string | null;
}>;

interface Props {
	products: GridItem[];
	/** where each card links to: "/shop" for shop products, "/others" for สินค้าสวัสดิการเดิม */
	hrefBase?: string;
	/** ordered by LINE / phone, not the shop: stock is not tracked, so never show "sold out" */
	contactOnly?: boolean;
}

const { products, contactOnly = false, hrefBase = "/shop" } = Astro.props;
const today = bangkokToday();
---

<ul class="products__grid">
	{products.map((p) => (
		<li>
			<a href={`${hrefBase}/${p.id}`} class="product">
				<span class="product__media">
					{p.data.image ? (
						<Image image={p.data.image} sizes="(min-width: 1000px) 240px, 50vw" />
					) : (
						<span class="product__placeholder">
							<img src="/logo.png" alt="" />
						</span>
					)}
					{(() => {
						const out = !contactOnly && (p.data.stock ?? 0) <= 0;
						const isNew = isNewProduct(p.data, today);
						const promo = promoActive(p.data, today);
						if (!out && !isNew && !promo) return null;
						// การ์ดแสดงแค่คำว่า "โปรโมชั่น" ช่วงวันที่แสดงในหน้ารายละเอียดสินค้า
						return (
							<span class="product__badges">
								{isNew && <span class="product__badge product__badge--new">สินค้าใหม่</span>}
								{promo && <span class="product__badge product__badge--promo">โปรโมชั่น</span>}
								{out && <span class="product__badge product__badge--out">สินค้าหมด</span>}
							</span>
						);
					})()}
				</span>
				<span class="product__body">
					<span class="product__name">{p.data.title}</span>
					{p.data.price != null && (
						<span class="product__price">
							{baht(p.data.price)}
							{p.data.unit && <span class="product__unit"> / {p.data.unit}</span>}
						</span>
					)}
					{!contactOnly && bulkLabel(p.data) && <span class="product__bulk">{bulkLabel(p.data)}</span>}
					{!contactOnly && bundleLabel(p.data) && <span class="product__bulk">{bundleLabel(p.data)}</span>}
				</span>
			</a>
		</li>
	))}
</ul>

<style>
	.products__grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--spacing-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.product {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: var(--card-padding);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		color: var(--color-text);
		text-decoration: none;
		transition:
			box-shadow var(--transition-base),
			translate var(--transition-base);
	}

	.product:hover {
		box-shadow: var(--shadow-card-hover);
		translate: 0 -2px;
	}

	.product__media {
		position: relative;
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.product__media > :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product__placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		background: linear-gradient(120deg, #0b1f47, #1d4185);
	}

	.product__placeholder img {
		width: 40%;
		height: auto;
		opacity: 0.5;
	}

	/* ป้ายมุมซ้ายบน: สินค้าใหม่ / โปรโมชั่น / สินค้าหมด */
	.product__badges {
		position: absolute;
		inset-inline-start: var(--spacing-2);
		top: var(--spacing-2);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 4px;
		max-width: calc(100% - var(--spacing-4));
	}

	.product__badge {
		padding: 2px var(--spacing-2);
		border-radius: var(--radius-full);
		font-size: var(--font-size-xs);
		font-weight: 600;
		line-height: 1.5;
		color: #fff;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
	}

	/* สีป้าย: ใหม่ = แดง · โปรโมชั่น = เขียว · สินค้าหมด = ดำโปร่ง (ตัวอักษรขาวทุกป้าย อ่านได้ชัดบนรูป) */
	.product__badge--new {
		background: #dc2626;
	}

	.product__badge--promo {
		background: #15803d;
	}

	.product__badge--out {
		background: rgb(0 0 0 / 0.65);
		font-weight: 400;
		box-shadow: none;
	}

	.product__body {
		display: grid;
		gap: var(--spacing-1);
		padding: var(--spacing-3) var(--spacing-3) var(--spacing-2);
	}

	.product__name {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-weight: 600;
		line-height: 1.45;
		color: var(--color-navy);
	}

	.product__price {
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-gold-text);
	}

	/* ราคาพิเศษเมื่อซื้อครบจำนวน */
	.product__bulk {
		justify-self: start;
		padding: 1px var(--spacing-2);
		border-radius: var(--radius);
		background: #fff1e6;
		font-size: var(--font-size-xs);
		font-weight: 600;
		line-height: 1.5;
		color: #9a3412;
	}

	.product__unit {
		font-size: var(--font-size-xs);
		font-weight: 400;
		color: var(--color-muted);
	}

	@media (max-width: 1000px) {
		.products__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.products__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--spacing-3);
		}
	}
</style>
