---
/**
 * Designed cover for news without a featured image: navy wash, gold accents,
 * the seal as a watermark, and the headline set in type. It fills its parent,
 * so the parent decides the shape (16:10 cards, 4:3 showcase, …).
 */
import { formatDate } from "../utils/locale";

interface Props {
	title: string;
	/** Seeds the colour variant so neighbouring covers differ */
	seed: string;
	label?: string;
	date?: Date | null;
	/** Small covers (row thumbnails) drop the date and shrink the type */
	compact?: boolean;
}

const { title, seed, label = "ข่าวประชาสัมพันธ์", date, compact = false } = Astro.props;

// Four navy/gold moods, picked by an FNV-1a hash of the seed
let hash = 0x811c9dc5;
for (const c of seed) hash = Math.imul(hash ^ c.charCodeAt(0), 0x01000193) >>> 0;
const variant = (hash >>> 16) % 4;
---

<div class:list={["cover", `cover--v${variant}`, { "cover--compact": compact }]} aria-hidden="true">
	<img src="/logo.png" alt="" class="cover__seal" />
	<span class="cover__rule"></span>
	<div class="cover__body">
		<span class="cover__label">{label}</span>
		<span class="cover__title">{title}</span>
		{
			!compact && (
				<span class="cover__foot">
					<span>สวัสดิการ สตง.</span>
					{date && <span>{formatDate(date, "long")}</span>}
				</span>
			)
		}
	</div>
</div>

<style>
	.cover {
		position: absolute;
		inset: 0;
		overflow: hidden;
		isolation: isolate;
		container-type: inline-size;
		color: #fff;
		background:
			radial-gradient(70% 90% at 90% 10%, rgb(231 200 96 / 0.3), transparent 60%),
			linear-gradient(135deg, #0b1f47 0%, #0f2a5c 50%, #1d4185 100%);
	}

	.cover--v1 {
		background:
			radial-gradient(60% 80% at 10% 100%, rgb(231 200 96 / 0.28), transparent 60%),
			linear-gradient(160deg, #13306a 0%, #0f2a5c 45%, #081936 100%);
	}

	.cover--v2 {
		background:
			radial-gradient(80% 70% at 100% 100%, rgb(201 162 39 / 0.35), transparent 60%),
			linear-gradient(120deg, #1d4185 0%, #0f2a5c 60%, #0b1f47 100%);
	}

	.cover--v3 {
		color: #0f2a5c;
		background:
			radial-gradient(70% 90% at 95% 5%, rgb(255 255 255 / 0.45), transparent 60%),
			linear-gradient(135deg, #e7c860 0%, #c9a227 55%, #a8851a 100%);
	}

	/* Faint diagonal sheen across the card */
	.cover::before {
		content: "";
		position: absolute;
		inset: -20%;
		z-index: -1;
		background: repeating-linear-gradient(
			115deg,
			rgb(255 255 255 / 0.04) 0 2px,
			transparent 2px 18px
		);
	}

	.cover__seal {
		position: absolute;
		z-index: -1;
		inset-inline-end: -12%;
		top: 50%;
		width: 62%;
		height: auto;
		translate: 0 -50%;
		opacity: 0.16;
	}

	.cover--v3 .cover__seal {
		opacity: 0.22;
		mix-blend-mode: multiply;
	}

	.cover__rule {
		position: absolute;
		inset: auto 0 0;
		height: 4px;
		background: linear-gradient(90deg, #a8851a, #e7c860, #c9a227);
	}

	.cover--v3 .cover__rule {
		background: #0f2a5c;
	}

	.cover__body {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 3cqi;
		padding: 7cqi 7cqi 8cqi;
	}

	.cover__label {
		align-self: flex-start;
		padding: 0.5cqi 2.4cqi;
		border-radius: 999px;
		background: #c9a227;
		font-size: max(10px, 3.2cqi);
		font-weight: 600;
		color: #0f2a5c;
	}

	.cover--v3 .cover__label {
		background: #0f2a5c;
		color: #fff;
	}

	.cover__title {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		max-width: 88%;
		font-size: max(14px, 7cqi);
		font-weight: 700;
		line-height: 1.3;
		text-wrap: balance;
		text-shadow: 0 2px 14px rgb(0 0 0 / 0.25);
	}

	.cover--v3 .cover__title {
		text-shadow: none;
	}

	.cover__foot {
		display: flex;
		justify-content: space-between;
		gap: 2cqi;
		font-size: max(10px, 3cqi);
		opacity: 0.8;
	}

	.cover--compact .cover__body {
		gap: 2cqi;
		padding: 6cqi;
	}

	.cover--compact .cover__label {
		display: none;
	}

	.cover--compact .cover__title {
		-webkit-line-clamp: 2;
		font-size: max(11px, 9cqi);
	}
</style>
