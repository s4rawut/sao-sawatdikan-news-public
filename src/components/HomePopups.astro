---
/**
 * Pop-ups on the home page, from the "home_popups" collection (published + "เปิดแสดง" ticked, sort_order ascending).
 * They open one after another; each shows its banner slides (show_banners) and/or its content.
 * Content with a bullet list is drawn as feature cards (icon picked from the item's words; display only, not links)
 * under a navy header with the seal; other content renders as normal rich text.
 * Shown once per browser session per pop-up version (editing a pop-up shows it again).
 */
import { PortableText } from "emdash/ui";
import BannerSlider, { type BannerEntry } from "./BannerSlider.astro";
import { DEFAULT_LOGO } from "../utils/site-identity";

type Block = {
	_type?: string;
	listItem?: string;
	markDefs?: Array<{ _key: string; _type: string; href?: string }>;
	children?: Array<{ text?: string; marks?: string[] }>;
};
interface PopupEntry {
	id: string;
	data: {
		id?: string;
		title?: string;
		show_banners?: boolean | null;
		content?: Block[] | null;
		updated_at?: string | Date | null;
	};
}
interface Props {
	popups: PopupEntry[];
	banners: BannerEntry[];
}
const { popups, banners } = Astro.props;
const version = (p: PopupEntry) => `${p.data.id ?? p.id}:${String(p.data.updated_at ?? "")}`;

/** Icons (Lucide paths) chosen by the words in each feature */
const ICONS: Array<[RegExp, string]> = [
	[/สินค้า|ร้านค้า|จำหน่าย/, '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>'],
	[/ภารกิจ|คณะกรรมการ/, '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'],
	[/สิทธิประโยชน์/, '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>'],
	[/ข่าว|ประชาสัมพันธ์/, '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>'],
	[/ระเบียบ|หลักเกณฑ์/, '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>'],
	[/การเงิน|รายงาน/, '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>'],
	[/ชมรม/, '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>'],
];
const SPARKLE = '<path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2Z"/>';
const iconFor = (text: string) => ICONS.find(([re]) => re.test(text))?.[1] ?? SPARKLE;

/** Split content into intro blocks and list items → cards { text, href, icon } */
function parts(content: Block[] | null | undefined) {
	const blocks = Array.isArray(content) ? content : [];
	const items = blocks
		.filter((b) => b._type === "block" && b.listItem)
		.map((b) => {
			const text = (b.children ?? []).map((c) => c.text ?? "").join("").trim();
			const key = (b.children ?? []).flatMap((c) => c.marks ?? []).find((m) => b.markDefs?.some((d) => d._key === m));
			const href = b.markDefs?.find((d) => d._key === key && d._type === "link")?.href;
			return { text, href, icon: iconFor(text) };
		})
		.filter((i) => i.text);
	const intro = blocks.filter((b) => !(b._type === "block" && b.listItem));
	return { items, intro };
}
---

{
	popups.map((p, i) => {
		const { items, intro } = parts(p.data.content);
		const feature = items.length > 0;
		return (
			<dialog class:list={["hpop", { "hpop--feature": feature }]} data-hpop data-version={version(p)} aria-labelledby={`hpop-t-${i}`}>
				<div class="hpop__box">
					{feature ? (
						<header class="hpop__hero">
							<img src={DEFAULT_LOGO} alt="" class="hpop__seal" />
							<div>
								<p class="hpop__eyebrow">สวัสดิการ สำนักงานการตรวจเงินแผ่นดิน</p>
								<h2 id={`hpop-t-${i}`}>{p.data.title}</h2>
							</div>
							<button type="button" class="hpop__x hpop__x--light" data-close aria-label="ปิด">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
							</button>
						</header>
					) : (
						<header class="hpop__head">
							<h2 id={`hpop-t-${i}`}>{p.data.title}</h2>
							<button type="button" class="hpop__x" data-close aria-label="ปิด">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
							</button>
						</header>
					)}
					<div class="hpop__main">
						{p.data.show_banners && banners.length > 0 && <BannerSlider banners={banners} label={p.data.title} />}
						{intro.length > 0 && (
							<div class="hpop__body">
								<PortableText value={intro} />
							</div>
						)}
						{feature && (
							<ul class="feat">
								{items.map((it, n) => (
									<li style={`--d:${n * 45}ms`}>
										<div class="feat__card">
											<span class="feat__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={it.icon} /></span>
											<span class="feat__text">{it.text}</span>
										</div>
									</li>
								))}
							</ul>
						)}
					</div>
					<footer class="hpop__foot">
						<button type="button" class="btn" data-close>
							{i < popups.length - 1 ? "ถัดไป" : "เข้าสู่เว็บไซต์"}
						</button>
					</footer>
				</div>
			</dialog>
		);
	})
}

<script>
	const KEY = "sao_popups_seen";
	const dialogs = [...document.querySelectorAll<HTMLDialogElement>("dialog[data-hpop]")];
	let seen: string[] = [];
	try {
		seen = JSON.parse(sessionStorage.getItem(KEY) || "[]");
	} catch {}
	const queue = dialogs.filter((d) => !seen.includes(d.dataset.version!));
	const remember = (d: HTMLDialogElement) => {
		seen.push(d.dataset.version!);
		try {
			sessionStorage.setItem(KEY, JSON.stringify(seen));
		} catch {}
	};
	const openNext = () => {
		const d = queue.shift();
		if (!d) return;
		d.showModal();
		d.scrollTop = 0;
		d.querySelector<HTMLElement>(".hpop__foot .btn")?.focus({ preventScroll: true });
	};
	for (const d of dialogs) {
		d.addEventListener("close", () => {
			remember(d);
			openNext();
		});
		d.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", () => d.close()));
		// click on the dimmed backdrop closes
		d.addEventListener("click", (e) => {
			if (e.target === d) d.close();
		});
	}
	if (queue.length) setTimeout(openNext, 300);
</script>

<style>
	.hpop {
		width: min(960px, calc(100vw - 24px));
		max-height: calc(100dvh - 24px);
		padding: 0;
		border: 0;
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
	}

	.hpop--feature {
		width: min(780px, calc(100vw - 24px));
	}

	.hpop::backdrop {
		background: rgb(0 0 0 / 0.72);
	}

	.hpop[open] {
		animation: hpop-in 0.25s ease-out;
	}

	@keyframes hpop-in {
		from {
			opacity: 0;
			transform: translateY(14px) scale(0.98);
		}
	}

	.hpop__box {
		display: grid;
	}

	.hpop__main {
		display: grid;
		gap: var(--spacing-4);
		padding: var(--spacing-5);
	}

	.hpop__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding: var(--spacing-5) var(--spacing-5) 0;
	}

	.hpop__head h2 {
		margin: 0;
		font-size: var(--font-size-xl);
		color: var(--color-navy, var(--color-text));
	}

	/* Feature pop-up header: navy wash, gold rule, the seal */
	.hpop__hero {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: var(--spacing-6) var(--spacing-6) var(--spacing-5);
		overflow: hidden;
		background:
			radial-gradient(70% 120% at 100% 0%, rgb(201 162 39 / 0.3), transparent 60%),
			linear-gradient(120deg, #0b1f47 0%, #0f2a5c 55%, #1d4185 100%);
		color: #fff;
	}

	.hpop__hero::after {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 4px;
		background: linear-gradient(90deg, #a8851a, #e7c860, #c9a227);
	}

	.hpop__seal {
		flex: none;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 0 3px rgb(231 200 96 / 0.6), 0 6px 18px rgb(0 0 0 / 0.3);
	}

	.hpop__eyebrow {
		margin: 0 0 var(--spacing-2);
		font-size: var(--font-size-sm);
		line-height: 1.5;
		color: #e7c860;
		letter-spacing: 0.02em;
	}

	.hpop__hero h2 {
		margin: 0;
		font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
		font-weight: 700;
		line-height: 1.55;
		color: #fff;
	}

	.hpop__x {
		display: grid;
		flex: none;
		place-items: center;
		width: 38px;
		height: 38px;
		margin-inline-start: auto;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
	}

	.hpop__x--light {
		align-self: flex-start;
		border-color: rgb(255 255 255 / 0.35);
		background: rgb(255 255 255 / 0.12);
		color: #fff;
	}

	.hpop__x svg {
		width: 18px;
		height: 18px;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
	}

	.hpop__body {
		font-size: var(--font-size-lg);
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	.hpop__body :global(p) {
		margin: 0;
	}

	/* Feature cards */
	.feat {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.feat li {
		animation: feat-in 0.35s ease-out backwards;
		animation-delay: var(--d);
	}

	@keyframes feat-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.feat__card {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		height: 100%;
		padding: var(--spacing-3) var(--spacing-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}

	.feat__icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: linear-gradient(135deg, #0f2a5c, #1d4185);
		color: #e7c860;
	}

	.feat__icon svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.feat__text {
		flex: 1;
		font-weight: 600;
		line-height: 1.45;
	}

	.hpop__foot {
		display: flex;
		justify-content: flex-end;
		padding: 0 var(--spacing-5) var(--spacing-5);
	}

	@media (max-width: 640px) {
		.feat {
			grid-template-columns: minmax(0, 1fr);
		}

		.hpop__hero {
			padding: var(--spacing-5) var(--spacing-4) var(--spacing-4);
		}

		.hpop__seal {
			width: 48px;
			height: 48px;
		}

		.hpop__main {
			gap: var(--spacing-3);
			padding: var(--spacing-4);
		}

		.hpop__body {
			font-size: var(--font-size-base);
		}

		.feat {
			gap: var(--spacing-2);
		}

		.feat__card {
			padding: var(--spacing-2) var(--spacing-3);
		}

		.feat__icon {
			width: 36px;
			height: 36px;
			border-radius: 10px;
		}

		.feat__icon svg {
			width: 19px;
			height: 19px;
		}

		.hpop__foot {
			padding: 0 var(--spacing-4) var(--spacing-4);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hpop[open],
		.feat li {
			animation: none;
		}

		.feat__card {
			transition: none;
		}
	}
</style>
