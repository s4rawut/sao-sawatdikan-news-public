				align-items: center;
				gap: var(--spacing-4);
				padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem) var(--spacing-6);
				text-align: center;
			}

			.site-footer__logo {
				flex: none;
				display: grid;
				place-items: center;
				width: clamp(88px, 70px + 4vw, 128px);
				aspect-ratio: 1;
				border-radius: var(--radius-full);
				background: var(--color-surface);
				box-shadow: var(--shadow-card);
			}

			.site-footer__logo img {
				width: 78%;
				height: 78%;
				object-fit: contain;
			}

			.site-footer__info {
				display: grid;
				justify-items: center;
				gap: var(--spacing-3);
				min-width: 0;
			}

			.site-footer__org {
				font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
				font-weight: 700;
				line-height: 1.35;
				color: var(--color-navy);
			}

			.site-footer__address {
				color: var(--color-text-secondary);
			}

			.site-footer__contacts {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: var(--spacing-3) var(--spacing-8);
				margin-top: var(--spacing-1);
				list-style: none;
			}

			.site-footer__contact {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-3);
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.site-footer__contact:hover {
				color: var(--color-navy);
			}

			.site-footer__icon {
				display: grid;
				place-items: center;
				flex: none;
				width: 44px;
				height: 44px;
				border-radius: var(--radius-full);
				background: var(--color-navy);
				color: #fff;
			}

			.site-footer__icon svg {
				width: 20px;
				height: 20px;
			}

			.site-footer__links {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-2) 0;
				padding-bottom: var(--spacing-6);
			}

			.site-footer__links a {
				font-weight: 600;
				color: var(--color-navy);
				text-decoration: none;
			}

			.site-footer__links a:hover {
				text-decoration: underline;
			}

			/* เส้นคั่นบาง ๆ ระหว่างลิงก์ */
			.site-footer__links a + a::before {
				content: "";
				display: inline-block;
				width: 1px;
				height: 1em;
				margin-inline: var(--spacing-4);
				vertical-align: -0.12em;
				background: var(--color-border);
			}

			/* จอแคบ: ลิงก์นโยบายเรียงลงทีละบรรทัด ไม่มีเส้นคั่นค้างหน้าบรรทัด */
			@media (max-width: 640px) {
				.site-footer__links {
					flex-direction: column;
					gap: var(--spacing-2);
				}

				.site-footer__links a + a::before {
					display: none;
				}
			}

			.site-footer__bottom {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				gap: var(--spacing-4);
				padding-block: var(--spacing-5) var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.site-footer__meta {
				color: var(--color-text);
			}

			.site-footer__stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-2) var(--spacing-3);
			}

			.status-pill,
			.visits__chip {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-2);
				padding: 0.35em 0.9em;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-full);
				background: var(--color-surface);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.status-pill__dot {
				width: 8px;
				height: 8px;
				border-radius: var(--radius-full);
				background: var(--color-gold);
			}

			.visits {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-2);
			}

			.visits__label {
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.visits__chip b {
				font-weight: 700;
				color: var(--color-navy);
				font-variant-numeric: tabular-nums;
			}

			@media (forced-colors: active) {
				.site-nav a[aria-current] {
					border: 1px solid CanvasText;
				}
			}

			.nav-toggle {
				display: none;
			}

			/* Narrow screens: the menu folds into a drop-down under the nav row */
			@media (max-width: 1100px) {
				.site-header__inner {
					position: relative;
					align-items: center;
				}

				.nav-toggle {
					display: inline-flex;
					align-items: center;
					gap: var(--spacing-2);
					min-height: 2.5rem;
					padding: 0 var(--spacing-3);
					margin-inline-start: calc(-1 * var(--spacing-3));
					border: 0;
					border-radius: var(--radius);
					background: transparent;
					font: inherit;
					font-weight: 600;
					color: var(--color-navy);
					cursor: pointer;
				}

				.nav-toggle:hover {
					background: var(--color-navy-soft);
				}

				.nav-toggle svg {
					width: 22px;
					height: 22px;
				}

				.nav-toggle__close,
				.site-header[data-nav-open] .nav-toggle__open {
					display: none;
				}

				.site-header[data-nav-open] .nav-toggle__close {
					display: inline;
				}

				.site-nav {
					display: none;
					position: absolute;
					top: 100%;
					inset-inline: 0;
					max-height: calc(100dvh - var(--header-height, var(--nav-height)));
					overflow-y: auto;
					background: var(--color-surface);
					border-top: 1px solid var(--color-border);
					border-bottom: 1px solid var(--color-border);
					box-shadow: 0 12px 24px -12px var(--color-shadow-strong);
				}

				.site-header[data-nav-open] .site-nav {
					display: block;
				}

				.site-nav ul {
					flex-direction: column;
					flex-wrap: nowrap;
					height: auto;
					padding-block: var(--spacing-2);
				}

				.site-nav a {
					flex: 1;
					min-height: 48px;
					padding: 0 var(--frame-padding);
					border-bottom: 0;
					border-inline-start: 4px solid transparent;
					font-size: var(--font-size-base);
				}

				.site-nav a:hover {
					background: var(--color-navy-soft);
				}

				.site-nav a[aria-current] {
					background: var(--color-navy-soft);
					border-inline-start-color: var(--color-gold);
				}

				.site-nav__group {
					flex-direction: column;
				}

				.site-nav__parent {
					justify-content: space-between;
					width: 100%;
					min-height: 48px;
					padding: 0 var(--frame-padding);
					border-bottom: 0;
					border-inline-start: 4px solid transparent;
					font-size: var(--font-size-base);
					text-align: start;
				}

				.site-nav__parent:hover {
					background: var(--color-navy-soft);
				}

				.site-nav__parent[data-current] {
					border-inline-start-color: var(--color-gold);
				}

				.site-nav .site-nav__sub {
					position: static;
					min-width: 0;
					padding-block: 0;
					border: 0;
					border-radius: 0;
					box-shadow: none;
					background: transparent;
				}

				.site-nav .site-nav__sub a {
					min-height: 44px;
					padding-inline-start: calc(var(--frame-padding) + var(--spacing-4));
					border-inline-start-width: 4px;
				}
			}

			/* Phones: brand and actions on the first row, the nav on its own row */
			@media (max-width: 640px) {
				.site-header {
					--masthead-height: 84px;
				}

				.brand__seal {
					width: 56px;
					height: 56px;
				}

				.brand__sub {
					display: none;
				}

				.site-header__inner {
					align-items: center;
				}

				.site-search {
					display: none;
				}

				.shop-links--masthead {
					display: none;
				}

				.shop-links--nav {
					display: flex;
				}

				.shop-link--account [data-account-label] {
					display: none;
				}

				.site-search-link {
					display: inline-grid;
					width: 2.5rem;
					height: 2.5rem;
				}
			}

		</style>

		<script>
			// ⌘K / Ctrl+K focuses the header search
			const searchInput =
				document.querySelector<HTMLInputElement>(".site-search-input");
			document.addEventListener("keydown", (e) => {
				if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== "k") return;
				// The header search is hidden on small screens; leave the shortcut to the browser there
				if (!searchInput || searchInput.getClientRects().length === 0) return;
				e.preventDefault();
				searchInput.focus();
			});
		</script>
		<PdfModal />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
