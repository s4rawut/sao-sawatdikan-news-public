---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import PdfModal from "../components/PdfModal.astro";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import {
	CONTACT,
	POLICY_LINKS,
	DEFAULT_LOGO,
	SITE_STATUS,
	SHOW_FOOTER_EMAIL,
	resolveBlogSiteIdentity,
} from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteSubtitle, siteLogo } =
	resolveBlogSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "th";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">ข้ามไปยังเนื้อหา</a>
		<header class="site-header">
			<div class="masthead">
				<div class="frame masthead__inner">
					<a href="/" class="brand">
						<img
							src={siteLogo?.url ?? DEFAULT_LOGO}
							alt={siteLogo?.alt || siteTitle}
							class="brand__seal"
							width="80"
							height="80"
						/>
						<span class="brand__text">
							<span class="brand__name">{siteTitle}</span>
							{siteSubtitle && <span class="brand__sub">{siteSubtitle}</span>}
						</span>
					</a>
					<div class="site-search" role="search" aria-label="ค้นหาในเว็บไซต์">
						<svg
							class="site-search__icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
						<LiveSearch
							placeholder="ค้นหา"
							class="site-search__field"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages", "products", "legacy_products"]}
							routeMap={{ posts: "/posts/:path", pages: "/pages/:path", products: "/shop/:path", legacy_products: "/others/:path" }}
							searchPage="/search"
						/>
					</div>
					<div class="shop-links shop-links--masthead">
					<a href="/member#/cart" class="shop-link" aria-label="ตะกร้าสินค้า">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
						<span class="shop-link__count" data-cart-count hidden></span>
					</a>
					<a href="/member#/login" class="shop-link shop-link--account" data-account>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
						<span data-account-label>เข้าสู่ระบบ</span>
					</a>
					</div>
				</div>
			</div>
			<div class="frame site-header__inner">
				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="site-nav"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="nav-toggle__open" d="M4 6h16M4 12h16M4 18h16"></path><path class="nav-toggle__close" d="M6 6l12 12M18 6 6 18"></path></svg>
					<span>เมนู</span>
				</button>
				<nav class="site-nav" id="site-nav" aria-label="เมนูหลัก">
					<ul>
						{menuItems.map((item, i) => item.children?.length ? (
							<li class="site-nav__group">
								<button
									type="button"
									class="site-nav__parent"
									aria-expanded="false"
									aria-controls={`site-nav-sub-${i}`}
									data-current={item.children.some((c) => navCurrent(c.url)) ? "" : undefined}
								>
									{item.label}
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
								</button>
								<ul class="site-nav__sub" id={`site-nav-sub-${i}`}>
									{item.children.map((child) => (
										<li>
											<a
												href={child.url}
												target={child.target}
												rel={child.target === "_blank" ? "noopener noreferrer" : undefined}
												aria-current={navCurrent(child.url)}
											>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							</li>
						) : (
							<li>
								<a
									href={item.url}
									target={item.target}
									rel={
										item.target === "_blank"
											? "noopener noreferrer"
											: undefined
									}
									aria-current={navCurrent(item.url)}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				<div class="site-header__actions">
					<div class="shop-links shop-links--nav">
					<a href="/member#/cart" class="shop-link" aria-label="ตะกร้าสินค้า">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
						<span class="shop-link__count" data-cart-count hidden></span>
					</a>
					<a href="/member#/login" class="shop-link shop-link--account" data-account>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
						<span data-account-label>เข้าสู่ระบบ</span>
					</a>
					</div>
					<a
						href="/search"
						class="icon-btn site-search-link"
						aria-label="ค้นหา"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
							></path></svg
						>
					</a>
				</div>
			</div>
		</header>
		<script is:inline>
			// Inline, so the height is set before the browser scrolls to a URL fragment
			(function () {
				// Only the nav row stays pinned; the masthead scrolls away
				var header = document.querySelector(".site-header__inner");
				function setHeight() {
					document.documentElement.style.setProperty(
						"--header-height",
						header.offsetHeight + "px",
					);
				}
				setHeight();
				new ResizeObserver(setHeight).observe(header);

				// Narrow screens: the menu collapses behind the "เมนู" button
				var site = document.querySelector(".site-header");
				var toggle = site.querySelector(".nav-toggle");
				var nav = site.querySelector(".site-nav");
				function setOpen(open) {
					site.toggleAttribute("data-nav-open", open);
					toggle.setAttribute("aria-expanded", String(open));
				}
				toggle.addEventListener("click", function () {
					setOpen(!site.hasAttribute("data-nav-open"));
				});
				// Submenus: the parent button toggles its list (hover also opens it on desktop)
				function closeSubs(except) {
					nav.querySelectorAll(".site-nav__parent[aria-expanded='true']").forEach(function (b) {
						if (b !== except) b.setAttribute("aria-expanded", "false");
					});
				}
				nav.addEventListener("click", function (e) {
					var parent = e.target.closest(".site-nav__parent");
					if (parent) {
						var open = parent.getAttribute("aria-expanded") !== "true";
						closeSubs(parent);
						parent.setAttribute("aria-expanded", String(open));
						return;
					}
					if (e.target.closest("a")) {
						closeSubs();
						setOpen(false);
					}
				});
				document.addEventListener("click", function (e) {
					if (!nav.contains(e.target)) closeSubs();
					if (site.hasAttribute("data-nav-open") && !header.contains(e.target)) setOpen(false);
				});
				document.addEventListener("keydown", function (e) {
					var openSub = nav.querySelector(".site-nav__parent[aria-expanded='true']");
					if (e.key === "Escape" && openSub) {
						closeSubs();
						openSub.focus();
						return;
					}
					if (e.key === "Escape" && site.hasAttribute("data-nav-open")) {
						setOpen(false);
						toggle.focus();
					}
				});
				matchMedia("(min-width: 1101px)").addEventListener("change", function () {
					setOpen(false);
				});
			})();
		</script>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="frame site-footer__main">
				<a href="/" class="site-footer__logo" aria-label={siteTitle}>
					<img src={siteLogo?.url ?? DEFAULT_LOGO} alt="" width="120" height="120" loading="lazy" />
				</a>
				<div class="site-footer__info">
					<p class="site-footer__org">{CONTACT.org}</p>
					<p class="site-footer__address">{CONTACT.address}</p>
					<ul class="site-footer__contacts">
						<li>
							<a class="site-footer__contact" href={`tel:${CONTACT.phone.replace(/\s|ต่อ.*$/g, "")}`}>
								<span class="site-footer__icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M13.83 16.57a1 1 0 0 0 1.21-.3l.36-.47A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.47.35a1 1 0 0 0-.29 1.23 14 14 0 0 0 6.39 6.39"></path></svg>
								</span>
								<span><span class="sr-only">โทรศัพท์ </span>{CONTACT.phone}</span>
							</a>
						</li>
						{SHOW_FOOTER_EMAIL && (
							<li>
								<a class="site-footer__contact" href={`mailto:${CONTACT.email}`}>
									<span class="site-footer__icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
									</span>
									<span><span class="sr-only">อีเมล </span>{CONTACT.email}</span>
								</a>
							</li>
						)}
					</ul>
				</div>
			</div>
			<nav class="frame site-footer__links" aria-label="นโยบาย">
				{POLICY_LINKS.map((l) => (
					<a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
				))}
			</nav>
			<div class="frame site-footer__bottom">
				<p class="site-footer__meta">{`© สงวนลิขสิทธิ์ ${year + 543} ${CONTACT.org}`}</p>
				<div class="site-footer__stats">
					{
						SITE_STATUS && (
							<p class="status-pill">
								<span class="status-pill__dot" aria-hidden="true" />
								{SITE_STATUS}
							</p>
						)
					}
					<dl class="visits" data-visits>
						<dt class="visits__label">ผู้เข้าชม</dt>
						<dd class="visits__chip">วันนี้ <b data-visits-today>–</b></dd>
						<dd class="visits__chip">เดือนนี้ <b data-visits-month>–</b></dd>
						<dd class="visits__chip">ทั้งหมด <b data-visits-total>–</b></dd>
					</dl>
				</div>
			</div>
		</footer>

		<script>
			// Header cart badge and account link (shop members, not EmDash users)
			// The links appear twice: in the masthead (desktop) and in the nav row (phones)
			const cartBadges = document.querySelectorAll<HTMLElement>("[data-cart-count]");
			const accounts = document.querySelectorAll<HTMLAnchorElement>("[data-account]");
			const accountLabels = document.querySelectorAll<HTMLElement>("[data-account-label]");
			function cartCount(): number {
				try {
					const cart = JSON.parse(localStorage.getItem("sao_cart") || "[]");
					return cart.reduce((n: number, i: { qty: number }) => n + (i.qty || 0), 0);
				} catch {
					return 0;
				}
			}
			function showCart(n = cartCount()) {
				cartBadges.forEach((badge) => {
					badge.textContent = String(n);
					badge.hidden = n === 0;
				});
			}
			function showUser(user: { name: string } | null) {
				accounts.forEach((a) => (a.href = user ? "/member#/orders" : "/member#/login"));
				accountLabels.forEach((l) => (l.textContent = user ? user.name.split(" ")[0] : "เข้าสู่ระบบ"));
			}
			showCart();
			window.addEventListener("storage", (e) => e.key === "sao_cart" && showCart());
			window.addEventListener("shop:changed", (e) => {
				const { user, count } = (e as CustomEvent).detail;
				showCart(count);
				// The product page only reports the cart; it does not know who is signed in
				if (user !== undefined) showUser(user);
			});
			fetch("/api/shop/auth/me")
				.then((r) => (r.ok ? r.json() : { user: null }))
				.then((d) => showUser(d.user))
				.catch(() => {});

			// Footer visitor counter: each browser counts once per day
			(async () => {
				const day = new Intl.DateTimeFormat("en-CA", {
					timeZone: "Asia/Bangkok",
				}).format(new Date());
				let seen = false;
				try {
					seen = localStorage.getItem("visit-day") === day;
				} catch {}
				try {
					const res = await fetch("/api/visit", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify({ new: !seen }),
					});
					if (!res.ok) return;
					const data = await res.json();
					const fmt = new Intl.NumberFormat("th-TH");
					for (const key of ["today", "month", "total"]) {
						const el = document.querySelector(`[data-visits-${key}]`);
						if (el) el.textContent = fmt.format(data[key]);
					}
					try {
						localStorage.setItem("visit-day", day);
					} catch {}
				} catch {}
			})();
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					-webkit-text-size-adjust: 100%;
				}

				/*
				 * Fragment targets clear the sticky header. Not a scroll-padding
				 * on html: that also applies to the search field inside the
				 * header, and the page scrolls on every keystroke.
				 * --header-height is measured by a script, since the header
				 * grows when the menu wraps.
				 */
				:target {
					scroll-margin-block-start: calc(
						var(--header-height, var(--nav-height)) + var(--spacing-6)
					);
				}

				body {
					display: flex;
					flex-direction: column;
					min-height: 100vh;
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
				}

				/*
				 * The frame rails: two hairlines that run the full height of
				 * the page at the edges of the content frame. Fixed and behind
				 * everything, so any surface with a background covers them.
				 */
				body::before {
					content: "";
					position: fixed;
					inset-block: 0;
					inset-inline: 0;
					z-index: -1;
					width: var(--frame-width);
					margin-inline: auto;
					border-inline: 1px solid var(--color-border);
					pointer-events: none;
				}

				main {
					flex: 1;
				}

				main:focus {
					outline: none;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration-line: underline;
					text-decoration-thickness: 1px;
					text-decoration-color: var(--color-border-strong);
					text-underline-offset: 0.2em;
					transition:
						color var(--transition-fast),
						text-decoration-color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					text-decoration-color: currentColor;
				}

				:where(:not([class*="emdash"]):not([class*="ec-"])):focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
					text-wrap: balance;
					overflow-wrap: break-word;
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				p {
					text-wrap: pretty;
				}

				kbd {
					font-family: var(--font-mono);
				}

				@media (max-width: 640px) {
					:target {
						scroll-margin-block-start: var(--spacing-6);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					html {
