---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import NewsShowcase from "../components/NewsShowcase.astro";
import ShopProducts from "../components/ShopProducts.astro";
import BannerSlider from "../components/BannerSlider.astro";
import HomePopups from "../components/HomePopups.astro";
import { DEFAULT_LOGO, resolveBlogSiteIdentity } from "../utils/site-identity";

// The home page shows only the newest few; everything else lives on /posts
const SHOWCASE_COUNT = 5;

// แบนเนอร์และป๊อปอัปหน้าแรก (หลังบ้าน → แบนเนอร์หน้าแรก / ป๊อปอัปหน้าแรก) — ยังไม่สร้างหมวด = ไม่แสดง
const optional = (slug: string) => getEmDashCollection(slug as "posts", { limit: 50 }).catch(() => ({ entries: [] as never[] }));
const bySort = (a: { data: Record<string, unknown> }, b: { data: Record<string, unknown> }) =>
	(Number(a.data.sort_order) || 0) - (Number(b.data.sort_order) || 0);
const [{ entries: posts, cacheHint }, settings, bannerRes, popupRes] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: SHOWCASE_COUNT,
	}),
	getSiteSettings(),
	optional("home_banners"),
	optional("home_popups"),
]);
const banners = [...bannerRes.entries].sort(bySort) as never[];
const allPopups = [...popupRes.entries].sort(bySort) as Array<{ id: string; data: Record<string, unknown> }>;
// ป๊อปอัปที่ติ๊ก "เปิดแสดง" · ป๊อปอัปแบนเนอร์ที่ไม่มีแบนเนอร์และไม่มีเนื้อหา ข้ามไป
const popups = allPopups.filter(
	(p) => p.data.enabled && ((p.data.show_banners && banners.length) || (Array.isArray(p.data.content) && p.data.content.length)),
) as never[];
const inlineBanners = banners.length > 0 && allPopups.some((p) => p.data.show_inline);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<header class="hero">
		<img src={DEFAULT_LOGO} alt="" class="hero__seal" aria-hidden="true" />
		<div class="frame hero__inner">
			<h1 class="hero__title">{siteTitle}</h1>
			{siteTagline && <p class="hero__subtitle">{siteTagline}</p>}
		</div>
	</header>

	{
		inlineBanners && (
			<section class="band section home-banners" aria-label="แบนเนอร์">
				<div class="frame">
					<BannerSlider banners={banners} />
				</div>
			</section>
		)
	}

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">ยังไม่มีข่าวสาร</h2>
						<p class="empty-state__text">
							เริ่มเขียนข่าวแรกได้ที่หน้าหลังบ้าน
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								เขียนข่าวใหม่
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<NewsShowcase posts={posts} />
		)
	}

	<ShopProducts count={10} />

	<HomePopups popups={popups} banners={banners} />
</Base>

<style>
	/* Full-bleed banner: navy wash, gold glints, the seal as a watermark */
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(60% 90% at 85% 20%, rgb(201 162 39 / 0.28), transparent 60%),
			radial-gradient(50% 80% at 0% 100%, rgb(29 65 133 / 0.9), transparent 70%),
			linear-gradient(120deg, #0b1f47 0%, #0f2a5c 45%, #1d4185 100%);
		color: #fff;
	}

	.hero::after {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 5px;
		background: linear-gradient(90deg, #a8851a, #e7c860, #c9a227);
	}

	.hero__seal {
		position: absolute;
		z-index: -1;
		inset-inline-end: -4%;
		top: 50%;
		width: min(560px, 60vw);
		translate: 0 -50%;
		opacity: 0.14;
		filter: grayscale(0.3);
		pointer-events: none;
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: center;
		gap: var(--spacing-4);
		min-height: clamp(320px, 42vw, 520px);
		padding-block: var(--spacing-16);
	}

	.hero__title {
		max-width: 18ch;
		font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem);
		font-weight: 700;
		line-height: 1.2;
		color: #fff;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.25);
	}

	.hero__subtitle {
		max-width: 46ch;
		font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.4rem);
		line-height: 1.6;
		color: rgb(255 255 255 / 0.88);
	}
</style>
